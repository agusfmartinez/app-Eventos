# Copiar a .env y completar. NUNCA commitear .env.

# Postgres — coincide con docker-compose.yml en desarrollo
DATABASE_URL="postgresql://eventos:eventos_dev@localhost:5432/eventos?schema=public"

# Auth.js — generar con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=""

# URL pública de la app. Se usa para armar los links de invitación /i/:token.
# En producción tiene que ser https (la cámara del scanner no funciona sin TLS).
APP_URL="http://localhost:3000"

# Seed del primer admin (solo se usa al correr `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@salon.local"
SEED_ADMIN_PASSWORD="cambiar-esto-ya"
SEED_ADMIN_NAME="Administrador"
