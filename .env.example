# Copiar a .env y completar. NUNCA commitear .env.

# Postgres — coincide con docker-compose.yml en desarrollo
DATABASE_URL="postgresql://eventos:eventos_dev@localhost:5432/eventos?schema=public"

# Auth.js — generar con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=""

# URL pública de la app. Se usa para armar los links de invitación /i/:token.
# En producción tiene que ser https (la cámara del scanner no funciona sin TLS).
APP_URL="http://localhost:3000"

# Datos del salón de este cliente. La app es un producto estándar: se despliega
# una copia por cliente y lo que cambia entre uno y otro va acá, no en la base.
#
# VENUE_ADDRESS es la dirección por defecto de todos los eventos. Solo se pisa
# cuando el evento tiene dirección propia (un catering afuera) o cuando el
# cliente tiene varias sedes y cada espacio lleva la suya.
VENUE_NAME="Salón de Eventos"
VENUE_ADDRESS=""

# Contra qué server corren los smoke tests. Separada de APP_URL a propósito:
# apuntar APP_URL a un túnel para probar en el celular no debe romper los tests.
TEST_BASE_URL="http://localhost:3000"

# Seed del primer admin (solo se usa al correr `npm run db:seed`).
# El usuario para ingresar se genera del nombre y el apellido: Admin Salon -> ASALON
SEED_ADMIN_FIRST_NAME="Admin"
SEED_ADMIN_LAST_NAME="Salon"
SEED_ADMIN_EMAIL="admin@salon.local"
SEED_ADMIN_PASSWORD="cambiar-esto-ya"

# Usuario del admin del seed. Lo usan los smoke tests para iniciar sesión.
SEED_ADMIN_USERNAME="ASALON"
