// Sistema de gestión de eventos y control de acceso
// Modelo de datos — ver ANALISIS.md secciones 5 y 6.
//
// Convención: nombres en inglés en el código, tablas/columnas en snake_case,
// UI en español.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum Role {
  ADMIN // puede todo
  ORGANIZER // administra eventos e invitados
  DOOR // control de acceso: escanea y registra ingresos

  @@map("role")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  FINISHED
  CANCELLED

  @@map("event_status")
}

enum InvitationStatus {
  PENDING // creada, todavía no confirmada
  ENABLED // puede ingresar
  BLOCKED // no puede ingresar aunque el QR sea válido
  CANCELLED

  @@map("invitation_status")
}

// ============================================================
// Personal del salón
// ============================================================

/// Las cuentas las crea un admin. No hay registro público.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// Con lo que se inicia sesión. Se genera de la inicial del nombre más el
  /// apellido: Agustín Martínez → AMARTINEZ. Ver lib/username.ts.
  username String @unique

  firstName String @map("first_name")
  lastName  String @map("last_name")

  /// Contacto, opcional. No se usa para iniciar sesión.
  email String? @unique

  passwordHash String @map("password_hash")

  /// La cuenta arranca con una contraseña temporal que genera el sistema y
  /// que el admin le pasa a la persona. Hasta que la cambie, la aplicación la
  /// manda siempre a la pantalla de cambio de contraseña.
  mustChangePassword Boolean @default(true) @map("must_change_password")

  role Role @default(DOOR)
  /// false corta el acceso en el próximo request (ver lib/auth.ts)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdEvents Event[]      @relation("EventCreatedBy")
  staffAt       EventStaff[]
  checkIns      CheckIn[]
  auditLogs     AuditLog[]

  @@map("users")
}

// ============================================================
// Espacios del salón
// ============================================================

/// Sub-salones o ambientes del mismo salón.
///
/// NO es multi-tenant: sigue habiendo un solo salón. Esto es un catálogo de
/// ambientes que se alquilan por separado y pueden tener eventos simultáneos.
model Space {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique
  /// Capacidad física del ambiente. Propone el cupo por defecto del evento.
  capacity Int?
  /// Dirección del ambiente.
  ///
  /// Vacía en el caso normal —un solo salón, la dirección viene del despliegue
  /// (`VENUE_ADDRESS`)— y cargada cuando el cliente tiene varias sedes y cada
  /// espacio está en otro lado. Ver lib/venue.ts.
  address  String?
  notes    String?
  /// Los espacios no se borran: se desactivan. Borrarlos dejaría eventos
  /// pasados sin ambiente y rompería el historial.
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  events Event[]

  @@map("spaces")
}

// ============================================================
// Eventos
// ============================================================

model Event {
  id   String @id @default(uuid()) @db.Uuid
  name String

  /// Fecha sin hora: el evento ocurre en una fecha del calendario local,
  /// no en un instante UTC.
  eventDate DateTime @map("event_date") @db.Date
  /// "HH:MM" en hora local del salón. String a propósito: guardarlo como
  /// timestamp arrastra zona horaria y rompe el historial.
  startTime String?  @map("start_time")
  endTime   String?  @map("end_time")

  location String?
  coverUrl String?     @map("cover_url")
  notes    String?
  status   EventStatus @default(DRAFT)

  /// Ambiente del salón donde se hace. Nullable: eventos cargados antes de
  /// que existieran los espacios, o eventos que ocupan todo el salón.
  spaceId String? @map("space_id") @db.Uuid

  /// Cupo de personas pactado con el anfitrión. Se propone desde la capacidad
  /// del espacio y se puede bajar.
  ///
  /// Es un acuerdo comercial, no un límite físico exacto: la aplicación avisa
  /// cuando se supera, pero no bloquea el alta de invitados.
  maxGuests Int? @map("max_guests")

  /// Formulario público de registro (Fase 10).
  ///
  /// El token es un portador: quien lo tenga puede registrarse. Por eso los
  /// controles reales no son "quién lo recibió" sino el cupo, la fecha límite
  /// y poder cerrarlo. Nullable porque el formulario se genera cuando se
  /// necesita, no en cada evento.
  registrationToken    String?   @unique @map("registration_token")
  registrationOpen     Boolean   @default(false) @map("registration_open")
  /// Último día en que se puede registrar. Inclusive.
  registrationDeadline DateTime? @map("registration_deadline") @db.Date
  /// Personas que puede anotar cada invitado, contándose. Arranca en 1: que
  /// sumar acompañantes sea una decisión explícita del salón.
  registrationMaxPeople Int      @default(1) @map("registration_max_people")
  /// Con auto-aprobación la invitación nace habilitada y la persona se lleva
  /// el QR en el momento. Apagarlo la deja en PENDING para que alguien la
  /// revise.
  registrationAutoApprove Boolean @default(true) @map("registration_auto_approve")

  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   User?        @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  space       Space?       @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  guests      Guest[]
  invitations Invitation[]
  staff       EventStaff[]
  checkIns    CheckIn[]

  @@index([eventDate])
  @@index([status])
  /// El calendario consulta "qué hay en este espacio en estas fechas".
  @@index([spaceId, eventDate])
  @@map("events")
}

/// Qué operador puede escanear en qué evento. Base del rol DOOR.
model EventStaff {
  eventId      String   @map("event_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  /// ej. "Puerta 1" — queda registrado en cada check-in
  stationLabel String?  @map("station_label")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
  @@map("event_staff")
}

// ============================================================
// Invitados e invitaciones
// ============================================================

model Guest {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  /// Solo dígitos, normalizado al guardar
  phone     String?
  email     String?
  notes     String?

  /// DNI, solo dígitos. Lo pide el formulario público: es con lo que la
  /// persona recupera su entrada si perdió el link, y lo que evita que se
  /// anote dos veces.
  document String? @db.VarChar(20)

  /// Se registró solo por el formulario público, no lo cargó el salón.
  viaRegistration Boolean @default(false) @map("via_registration")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitation Invitation?
  checkIns   CheckIn[]

  @@unique([eventId, document])
  @@index([eventId, lastName, firstName])
  @@index([eventId, phone])
  @@map("guests")
}

/// Acá vive la verdad del control de acceso.
///
/// Los estados INGRESADO y PARCIALMENTE INGRESADO del brief NO se guardan:
/// se derivan de enteredCount vs maxPeople. Guardarlos duplicaría estado.
model Invitation {
  id      String @id @default(uuid()) @db.Uuid
  guestId String @unique @map("guest_id") @db.Uuid
  /// Desnormalizado a propósito: el scanner filtra por evento en un solo índice
  eventId String @map("event_id") @db.Uuid

  /// Lo único que va dentro del QR. 22+ chars de crypto.randomBytes.
  /// Nunca Math.random(), nunca IDs incrementales.
  token     String @unique
  /// 8 chars legibles (sin 0/O/1/I) para tipear a mano si el QR no se lee
  shortCode String @map("short_code")

  maxPeople Int @map("max_people")
  /// Solo se modifica dentro de la transacción de check-in (ver lib/checkin.ts).
  /// La migración agrega CHECK (entered_count <= max_people).
  enteredCount Int @default(0) @map("entered_count")

  status InvitationStatus @default(ENABLED)
  /// Invalida el link público /i/:token
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  guest    Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkIns CheckIn[]

  @@unique([eventId, shortCode])
  @@index([eventId, status])
  @@map("invitations")
}

// ============================================================
// Registro de ingresos
// ============================================================

/// Libro mayor inmutable. Solo se inserta, nunca se edita ni se borra.
/// SUM(peopleCount) por invitación debe coincidir con Invitation.enteredCount.
model CheckIn {
  id           String @id @default(uuid()) @db.Uuid
  invitationId String @map("invitation_id") @db.Uuid
  guestId      String @map("guest_id") @db.Uuid
  eventId      String @map("event_id") @db.Uuid

  peopleCount  Int     @map("people_count")
  operatorId   String? @map("operator_id") @db.Uuid
  stationLabel String? @map("station_label")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest      Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  operator   User?      @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([invitationId])
  @@map("check_ins")
}

// ============================================================
// Auditoría
// ============================================================

model AuditLog {
  id       String  @id @default(uuid()) @db.Uuid
  actorId  String? @map("actor_id") @db.Uuid
  action   String
  entity   String
  entityId String? @map("entity_id")
  payload  Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_log")
}
